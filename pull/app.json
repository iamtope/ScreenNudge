{
  "expo": {
    "name": "ScreenNudge",
    "slug": "pull",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["screennudge", "pull"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abassadamo.pull",
      "appleTeamId": "B4BT4H7239",
      "associatedDomains": ["applinks:www.screennudge.com"],
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "ScreenNudge uses Screen Time to help you protect distracting apps and come back before doomscrolling takes over.",
        "NSMotionUsageDescription": "ScreenNudge can ask you to take a few steps as a pause before opening a distracting app.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.abassadamo.pull.device-activity",
            "CFBundleURLSchemes": ["device-activity"]
          }
        ]
      }
    },
    "android": {
      "package": "com.abassadamo.pull",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.abassadamo.pull",
          "copyToTargetFolder": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "buildReactNativeFromSource": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
